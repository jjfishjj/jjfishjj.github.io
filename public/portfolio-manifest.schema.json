{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jjfishjj.github.io/portfolio-manifest.schema.json",
  "title": "Jerome Kuo Portfolio Manifest",
  "description": "Canonical contract for the GitHub Pages and Hugging Face portfolio surfaces.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "updatedAt", "owner", "collectionUrl", "categories", "recruiter", "artifacts", "projects"],
  "properties": {
    "$schema": { "const": "https://jjfishjj.github.io/portfolio-manifest.schema.json" },
    "schemaVersion": { "const": 1 },
    "updatedAt": { "type": "string", "format": "date" },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "github", "huggingFace", "resume"],
      "properties": {
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "github": { "$ref": "#/$defs/httpsUrl" },
        "huggingFace": { "$ref": "#/$defs/httpsUrl" },
        "resume": { "$ref": "#/$defs/httpsUrl" }
      }
    },
    "collectionUrl": { "$ref": "#/$defs/httpsUrl" },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "zh", "en"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "zh": { "$ref": "#/$defs/nonEmptyString" },
          "en": { "$ref": "#/$defs/nonEmptyString" }
        }
      }
    },
    "recruiter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skills", "featuredArtifactIds"],
      "properties": {
        "skills": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "title", "summary"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "label": { "$ref": "#/$defs/nonEmptyString" },
              "title": { "$ref": "#/$defs/localizedText" },
              "summary": { "$ref": "#/$defs/localizedText" }
            }
          }
        },
        "featuredArtifactIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/artifact" }
    },
    "projects": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/project" }
    }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "httpsUrl": { "type": "string", "pattern": "^https://" },
    "localizedText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["zh", "en"],
      "properties": {
        "zh": { "$ref": "#/$defs/nonEmptyString" },
        "en": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "tags": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmptyString" } },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "icon", "title", "summary", "evidence", "tags", "url", "sourceUrl"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "enum": ["space", "model", "dataset"] },
        "icon": { "$ref": "#/$defs/nonEmptyString" },
        "title": { "$ref": "#/$defs/nonEmptyString" },
        "summary": { "$ref": "#/$defs/localizedText" },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "zh", "en"],
          "properties": {
            "type": { "$ref": "#/$defs/id" },
            "zh": { "$ref": "#/$defs/nonEmptyString" },
            "en": { "$ref": "#/$defs/nonEmptyString" }
          }
        },
        "tags": { "$ref": "#/$defs/tags" },
        "url": { "$ref": "#/$defs/httpsUrl" },
        "sourceUrl": { "$ref": "#/$defs/httpsUrl" },
        "featuredOrder": { "type": "integer", "minimum": 1 }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "category", "summary", "tags", "status", "evidenceType", "repoUrl"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "$ref": "#/$defs/nonEmptyString" },
        "category": { "$ref": "#/$defs/id" },
        "summary": { "$ref": "#/$defs/localizedText" },
        "tags": { "$ref": "#/$defs/tags" },
        "status": { "enum": ["live", "candidate", "external"] },
        "evidenceType": { "$ref": "#/$defs/id" },
        "demoUrl": { "$ref": "#/$defs/httpsUrl" },
        "repoUrl": { "$ref": "#/$defs/httpsUrl" }
      }
    }
  }
}
